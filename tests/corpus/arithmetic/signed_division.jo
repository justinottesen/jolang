// expect-exit: 87
// Division rounds toward zero, and the remainder has the sign of the dividend.
fn main() -> u8 {
    let q1: i8 = -7 / 2;    // -3 (rounding down would give -4)
    let r1: i8 = -7 % 2;    // -1 (rounding down would give 1)
    let q2: i8 = 7 / -2;    // -3
    let r2: i8 = 7 % -2;    // 1
    // Each term is non-negative only if its value is right: 1 * 64 + 1 * 16 + 1 * 4 + 3.
    let code = (q1 as i32 + 4) * 64 + (r1 as i32 + 2) * 16 + (q2 as i32 + 4) * 4 + (r2 as i32 + 2);
    code as u8
}
