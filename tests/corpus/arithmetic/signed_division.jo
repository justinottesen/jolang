// expect-exit: 0
// Division rounds toward zero, and the remainder has the sign of the dividend.
fn main() -> u8 {
    let seven: i8 = 7;
    let two: i8 = 2;
    if -seven / two != -3 { 1 }         // rounding down would give -4
    else if -seven % two != -1 { 2 }    // rounding down would give 1
    else if seven / -two != -3 { 3 }
    else if seven % -two != 1 { 4 }
    else if -seven / -two != 3 { 5 }
    else if -seven % -two != -1 { 6 }
    else { 0 }
}
