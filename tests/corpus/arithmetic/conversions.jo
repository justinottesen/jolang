// expect-exit: 0
fn main() -> u8 {
    let a: u8 = 200;
    let c: i32 = -1;
    let e: i8 = -2;
    let g: u64 = 18446744073709551615;
    let h: i64 = 255;
    if a as u32 * 100 != 20000 { 1 }        // widening never traps
    else if c as% u8 != 255 { 2 }           // wrapping keeps the low bits
    else if e as i64 != -2 { 3 }            // widening a signed value keeps it
    else if g as% u16 != 65535 { 4 }
    else if h as u8 != 255 { 5 }            // checked, and it fits
    else if c as i8 != -1 { 6 }
    else if a as i16 != 200 { 7 }
    else { 0 }
}
