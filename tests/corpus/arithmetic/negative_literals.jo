// expect-exit: 0
// `-` before a literal is part of it, so the minimum of each signed type can be written directly.
fn main() -> u8 {
    let a: i8 = -128;
    let b: i16 = -32768;
    let c: i32 = -2147483648;
    let d: i64 = -9223372036854775808;
    let e: i8 = - 5;
    if a + 127 != -1 { 1 }
    else if b + 32767 != -1 { 2 }
    else if c + 2147483647 != -1 { 3 }
    else if d + 9223372036854775807 != -1 { 4 }
    else if e != -5 { 5 }
    else { 0 }
}
