// expect-exit: 0
// Results that land exactly on the edge of the range don't trap.
fn main() -> u8 {
    let a: u8 = 254;
    let b: i8 = -127;
    let c: i32 = -2147483647;
    let d: u64 = 18446744073709551614;
    let e: i16 = 181;
    if a + 1 != 255 { 1 }
    else if b - 1 != -128 { 2 }
    else if c - 1 != -2147483648 { 3 }
    else if d + 1 != 18446744073709551615 { 4 }
    else if e * 181 != 32761 { 5 }         // 182 * 182 would overflow
    else if -b != 127 { 6 }
    else { 0 }
}
