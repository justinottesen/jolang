// expect-exit: 246
// Arithmetic near the top of each type's range.
fn main() -> u8 {
    let a: u16 = 60000 + 5000;
    let b: u32 = 4000000000 + 200000000;
    let c: u64 = 10000000000000000000 + 8000000000000000000;
    let d: i16 = -30000 - 2000;
    let e: i32 = -2000000000 - 100000000;
    let f: i64 = -9000000000000000000 - 200000000000000000;
    (a / 1000) as u8                        // 65
        + (b / 100000000) as u8             // 42
        + (c / 1000000000000000000) as u8   // 18
        + (d / -4000) as u8                 // 8
        + (e / -100000000) as u8            // 21
        + (f / -100000000000000000) as u8   // 92
}
