// expect-exit: 0
// Arithmetic near the top of each type's range.
fn main() -> u8 {
    let a: u16 = 60000;
    let b: u32 = 4000000000;
    let c: u64 = 10000000000000000000;
    let d: i16 = -30000;
    let e: i32 = -2000000000;
    let f: i64 = -9000000000000000000;
    if a + 5000 != 65000 { 1 }
    else if b + 200000000 != 4200000000 { 2 }
    else if c + 8000000000000000000 != 18000000000000000000 { 3 }
    else if d - 2000 != -32000 { 4 }
    else if e - 100000000 != -2100000000 { 5 }
    else if f - 200000000000000000 != -9200000000000000000 { 6 }
    else { 0 }
}
