// expect-exit: 0
fn main() -> u8 {
    let a: u8 = 20 - 5 - 3;     // (20 - 5) - 3, not 20 - (5 - 3) = 18
    let b: u8 = 100 / 10 / 2;   // (100 / 10) / 2, not 100 / (10 / 2) = 20
    let c: u8 = 50 % 7 * 2;     // (50 % 7) * 2, not 50 % (7 * 2) = 8
    if a != 12 { 1 }
    else if b != 5 { 2 }
    else if c != 2 { 3 }
    else { 0 }
}
