// expect-exit: 0
// Unsigned comparisons treat large values as large, not as negative.
fn main() -> u8 {
    let small: u8 = 1;
    let big: u8 = 255;
    let max: u64 = 18446744073709551615;
    let zero: u64 = 0;
    if !(big > small) { 1 }
    else if !(small < big) { 2 }
    else if !(max > zero) { 3 }
    else if !(zero < max) { 4 }
    else if !(big >= big and big <= big) { 5 }
    else if big < small or big <= small { 6 }
    else if !(big != small and big == 255) { 7 }
    else { 0 }
}
